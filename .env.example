# Copiar a .env (nunca subir .env). Generar secretos con: openssl rand -base64 32
APP_ENV=local                 # local | staging | preprod | production
HTTP_PORT=8080                # en Railway se usa PORT automáticamente
PUBLIC_APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=false             # true en Railway (usa X-Real-IP)

DB_HOST=
DB_PORT=6432
DB_NAME=bdt_mt_staging
DB_USER=                      # usuario *_app (solo EXECUTE)
DB_PASSWORD=
DB_MIGRATOR_USER=             # usuario *_migrator (solo para cmd/migrate)
DB_MIGRATOR_PASSWORD=
DB_TLS=

JWT_SECRET=                   # >= 32 caracteres
DATA_ENCRYPTION_KEY=          # 32 bytes base64 (AES-256-GCM)
BLIND_INDEX_KEY=              # 32 bytes base64 (HMAC para búsquedas)
APIKEY_PEPPER=                # 32 bytes base64
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_MINUTES=720
INVITATION_MINUTES=4320
RATE_LIMIT_PER_MIN=600
RATE_LIMIT_AUTH_PER_MIN=10

STORAGE_PATH=./data/files     # en Railway: volumen persistente, p. ej. /data/files

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
AUTFMI_BASE_URL=
AUTFMI_API_TOKEN=
